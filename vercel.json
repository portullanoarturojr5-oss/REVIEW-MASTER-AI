{
  "version": 2,
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/generate-reviewer",
      "destination": "/api/generate-reviewer"
    },
    {
      "source": "/api/grade-identification",
      "destination": "/api/grade-identification"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
